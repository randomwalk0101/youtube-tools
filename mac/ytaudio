#!/bin/bash

URL="${1:-}"
CUT_SECONDS="${2:-}"

if [ -z "$URL" ]; then
  read -p "YouTube链接: " URL
fi

if [ -z "${2+x}" ]; then
  CUT_SECONDS=""
  remaining=10
  while [ "$remaining" -gt 0 ]; do
    printf "\r提取前多少秒音频，直接回车下载完整音频（%2ds后自动下载完整音频）: " "$remaining"
    if IFS= read -r -t 1 CUT_SECONDS; then
      break
    fi
    remaining=$((remaining - 1))
  done
  printf "\n"
fi

COOKIE_BROWSER="${YTDLP_COOKIE_BROWSER:-safari}"
AUDIO_OUT_DIR="${YTAUDIO_OUT_DIR:-$HOME/Downloads/ytaudio}"

VIDEO_ID=$(python3 - "$URL" <<'PY'
import re
import sys
from urllib.parse import parse_qs, urlparse

url = sys.argv[1].strip()
parsed = urlparse(url)
host = parsed.netloc.lower()
path_parts = [part for part in parsed.path.split("/") if part]
query = parse_qs(parsed.query)

video_id = query.get("v", [""])[0]
if not video_id and "youtu.be" in host and path_parts:
    video_id = path_parts[0]
if not video_id and "youtube.com" in host and len(path_parts) >= 2 and path_parts[0] in {"live", "shorts", "embed"}:
    video_id = path_parts[1]
if not video_id:
    match = re.search(r"(?:v=|youtu\.be/|/live/|/shorts/|/embed/)([A-Za-z0-9_-]{6,})", url)
    video_id = match.group(1) if match else ""

print(video_id)
PY
)

if [ -z "$VIDEO_ID" ]; then
  echo "没有识别到视频ID"
  exit 1
fi

CLEAN_URL="https://www.youtube.com/watch?v=$VIDEO_ID"

TMPDIR="$HOME/Downloads/ytaudio/tmp_$VIDEO_ID"

mkdir -p "$TMPDIR" "$AUDIO_OUT_DIR"

YTDLP_ARGS=()
if [ -n "$COOKIE_BROWSER" ]; then
  YTDLP_ARGS+=(--cookies-from-browser "$COOKIE_BROWSER")
fi

if ! "$HOME/bin/yt-dlp" \
"${YTDLP_ARGS[@]}" \
"$CLEAN_URL" \
--no-playlist \
-f "bestaudio/best" \
-o "$TMPDIR/audio.%(ext)s"
then
  echo "yt-dlp failed. If Safari cookies are blocked on macOS, grant Full Disk Access to your terminal app or set YTDLP_COOKIE_BROWSER=chrome."
  rm -rf "$TMPDIR"
  exit 1
fi

AUDIOFILE=$(find "$TMPDIR" -type f | head -n 1)

if ! TITLE=$("$HOME/bin/yt-dlp" \
"${YTDLP_ARGS[@]}" \
--get-title \
--no-playlist \
"$CLEAN_URL" | head -n 1)
then
  echo "Could not read video title."
  rm -rf "$TMPDIR"
  exit 1
fi

SAFE_TITLE=$(echo "$TITLE" | tr '/:*?"<>|' '_' | cut -c 1-80)

if [ -z "$CUT_SECONDS" ]; then
  FINAL_NAME="${SAFE_TITLE}_full.mp3"

  ffmpeg -y \
  -i "$AUDIOFILE" \
  -vn \
  -ar 44100 \
  -ac 2 \
  -b:a 192k \
  "$AUDIO_OUT_DIR/$FINAL_NAME"
else
  FINAL_NAME="${SAFE_TITLE}_${CUT_SECONDS}s.mp3"

  ffmpeg -y \
  -i "$AUDIOFILE" \
  -t "$CUT_SECONDS" \
  -vn \
  -ar 44100 \
  -ac 2 \
  -b:a 192k \
  "$AUDIO_OUT_DIR/$FINAL_NAME"
fi

rm -rf "$TMPDIR"

echo ""
echo "完成：$AUDIO_OUT_DIR/$FINAL_NAME"
