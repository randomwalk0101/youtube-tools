#!/bin/bash

read -p "YouTube链接: " URL
read -p "提取前多少秒音频，直接回车下载完整音频: " CUT_SECONDS
COOKIE_BROWSER="${YTDLP_COOKIE_BROWSER:-safari}"

VIDEO_ID=$(echo "$URL" | sed -n 's/.*v=\([^&]*\).*/\1/p')

if [ -z "$VIDEO_ID" ]; then
  VIDEO_ID=$(echo "$URL" | sed -n 's#.*youtu\.be/\([^?&/]*\).*#\1#p')
fi

if [ -z "$VIDEO_ID" ]; then
  echo "没有识别到视频ID"
  exit 1
fi

CLEAN_URL="https://www.youtube.com/watch?v=$VIDEO_ID"

OUTDIR="$HOME/Downloads/ytaudio"
TMPDIR="$OUTDIR/tmp_$VIDEO_ID"

mkdir -p "$TMPDIR"

YTDLP_ARGS=()
if [ -n "$COOKIE_BROWSER" ]; then
  YTDLP_ARGS+=(--cookies-from-browser "$COOKIE_BROWSER")
fi

"$HOME/bin/yt-dlp" \
"${YTDLP_ARGS[@]}" \
"$CLEAN_URL" \
--no-playlist \
-f "bestaudio/best" \
-o "$TMPDIR/audio.%(ext)s"

AUDIOFILE=$(find "$TMPDIR" -type f | head -n 1)

TITLE=$("$HOME/bin/yt-dlp" \
"${YTDLP_ARGS[@]}" \
--get-title \
--no-playlist \
"$CLEAN_URL" | head -n 1)

SAFE_TITLE=$(echo "$TITLE" | tr '/:*?"<>|' '_' | cut -c 1-80)

if [ -z "$CUT_SECONDS" ]; then
  OUTFILE="$OUTDIR/${SAFE_TITLE}_full.mp3"

  ffmpeg -y \
  -i "$AUDIOFILE" \
  -vn \
  -ar 44100 \
  -ac 2 \
  -b:a 192k \
  "$OUTFILE"
else
  OUTFILE="$OUTDIR/${SAFE_TITLE}_${CUT_SECONDS}s.mp3"

  ffmpeg -y \
  -i "$AUDIOFILE" \
  -t "$CUT_SECONDS" \
  -vn \
  -ar 44100 \
  -ac 2 \
  -b:a 192k \
  "$OUTFILE"
fi

rm -rf "$TMPDIR"

echo ""
echo "完成：$OUTFILE"
