#!/usr/bin/env python3
import json
import os
import re
import shutil
import subprocess
import sys
from urllib.parse import urlparse, parse_qs

YTDLP = os.path.expanduser("~/bin/yt-dlp")
OUTDIR = os.path.expanduser("~/Downloads/ytdl")
os.makedirs(OUTDIR, exist_ok=True)


def clean_url(url):
    if "youtu.be/" in url:
        vid = url.split("youtu.be/")[1].split("?")[0].split("&")[0]
    else:
        q = parse_qs(urlparse(url).query)
        vid = q.get("v", [""])[0]
    if not vid:
        return None, None
    return vid, f"https://www.youtube.com/watch?v={vid}"


def safe_name(name):
    name = re.sub(r'[/:*?"<>|]', "_", name)
    return name[:100].strip() or "video"


if not os.path.exists(YTDLP):
    print(f"找不到 yt-dlp：{YTDLP}")
    print("请先安装 yt-dlp。")
    sys.exit(1)

if not shutil.which("ffmpeg"):
    print("找不到 ffmpeg。")
    print("请先执行：brew install ffmpeg")
    sys.exit(1)


url = input("YouTube链接: ").strip()
video_id, clean = clean_url(url)

if not video_id:
    print("没有识别到视频ID")
    sys.exit(1)

print(f"\n识别到视频ID：{video_id}")
print("正在读取清晰度列表...\n")

p = subprocess.run([YTDLP, "-J", "--no-playlist", clean], text=True, capture_output=True)

if p.returncode != 0:
    print(p.stderr)
    sys.exit(1)

info = json.loads(p.stdout)
title = safe_name(info.get("title", video_id))
formats = info.get("formats", [])

candidates = []

for f in formats:
    if f.get("vcodec") == "none":
        continue

    fmt_id = f.get("format_id")
    height = f.get("height") or 0
    width = f.get("width") or 0
    fps = f.get("fps") or 0
    ext = f.get("ext") or ""
    filesize = f.get("filesize") or f.get("filesize_approx") or 0

    if not fmt_id or not height:
        continue

    candidates.append({
        "format_id": fmt_id,
        "height": height,
        "width": width,
        "fps": fps,
        "ext": ext,
        "filesize": filesize,
    })

candidates.sort(key=lambda x: (x["height"], x["fps"], x["ext"] == "mp4"), reverse=True)

display = []
seen = set()

for c in candidates:
    key = (c["height"], c["fps"], c["ext"])
    if key in seen:
        continue
    seen.add(key)
    display.append(c)

print("可选清晰度：")
for i, c in enumerate(display, 1):
    size = f"{c['filesize'] / 1024 / 1024:.1f}MB" if c["filesize"] else ""
    h = f"{c['height']}p"
    fps = f"{c['fps']}fps" if c["fps"] else ""
    print(f"{i}. {h} {fps} {c['ext']} + m4a音频 {size}  format={c['format_id']}")

print("\n0. 自动选择最佳画质")

choice = input("\n输入数字选择清晰度: ").strip()

if choice == "0" or choice == "":
    fmt = "bv*[ext=mp4]+ba[ext=m4a]/bv*+ba/best"
else:
    if not choice.isdigit() or not (1 <= int(choice) <= len(display)):
        print("选择无效")
        sys.exit(1)

    selected = display[int(choice) - 1]
    fid = selected["format_id"]
    fmt = f"{fid}+ba[ext=m4a]/best"

print("\n字幕选项：")
print("0. 不下载字幕")
print("1. 中文字幕")
print("2. 英文字幕")
print("3. 中英字幕（默认）")
print("4. 全部可用字幕")

sub_choice = input("\n输入数字选择字幕语言，直接回车默认中英字幕: ").strip()

sub_args = []

if sub_choice == "0":
    sub_args = []
elif sub_choice == "1":
    sub_args = [
        "--write-sub",
        "--write-auto-sub",
        "--sub-langs", "zh-Hans,zh-CN,zh,zh-Hant",
        "--embed-subs",
    ]
elif sub_choice == "2":
    sub_args = [
        "--write-sub",
        "--write-auto-sub",
        "--sub-langs", "en",
        "--embed-subs",
    ]
elif sub_choice == "4":
    sub_args = [
        "--write-sub",
        "--write-auto-sub",
        "--all-subs",
        "--embed-subs",
    ]
else:
    sub_args = [
        "--write-sub",
        "--write-auto-sub",
        "--sub-langs", "zh-Hans,zh-CN,zh,zh-Hant,en",
        "--embed-subs",
    ]

outfile = os.path.join(OUTDIR, f"{title}.%(ext)s")

print(f"\n开始下载：{title}")
print(f"输出目录：{OUTDIR}\n")

cmd = [
    YTDLP,
    clean,
    "--no-playlist",
    "-f", fmt,
    "--merge-output-format", "mp4",
    *sub_args,
    "-o", outfile,
]

result = subprocess.run(cmd)

if result.returncode == 0:
    print(f"\n完成，文件在：{OUTDIR}")
else:
    print("\n下载失败，请查看上面的错误信息。")
    sys.exit(result.returncode)
